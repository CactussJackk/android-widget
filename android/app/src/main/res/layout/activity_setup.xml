<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textAppearance="@android:style/TextAppearance.Material.Headline" />

        <TextView
            android:id="@+id/setup_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@android:style/TextAppearance.Material.Body1" />

        <Button
            android:id="@+id/setup_scan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/setup_scan" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/setup_manual"
            android:textAppearance="@android:style/TextAppearance.Material.Subhead" />

        <EditText
            android:id="@+id/setup_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints="url"
            android:hint="@string/setup_url_hint"
            android:inputType="textUri"
            android:maxLines="1" />

        <EditText
            android:id="@+id/setup_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/setup_token_hint"
            android:importantForAutofill="no"
            android:inputType="textVisiblePassword|textNoSuggestions"
            android:maxLines="1" />

        <Button
            android:id="@+id/setup_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_save" />

        <Button
            android:id="@+id/setup_refresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/setup_refresh" />

        <Button
            android:id="@+id/setup_open"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_open" />

        <Button
            android:id="@+id/setup_disconnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_disconnect" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/setup_help"
            android:textAppearance="@android:style/TextAppearance.Material.Caption" />
    </LinearLayout>
</ScrollView>
